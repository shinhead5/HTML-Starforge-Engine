{
  "name": "starforge-engine-repo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @starforge/sandbox dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier -w .",
    "test": "pnpm --filter @starforge/engine test",
    "test:e2e": "pnpm --filter @starforge/sandbox test:e2e",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
